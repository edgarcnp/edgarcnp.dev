---
import Layout from "~/layouts/Layout.astro"
import { formatDate, getWritingPosts } from "~/lib/content"
import SectionHeading from "~/components/shared/SectionHeading.astro"
import TechTag from "~/components/shared/TechTag.astro"

const posts = await getWritingPosts()
---

<Layout title="Writings" description="Short technical writing about security, responsive UI, and deployment." path="/writings">
    <div class="space-y-8">
        <SectionHeading
            label="Writing"
            title="Notes from the build."
            description="Short technical writing about security, responsive UI, and deployment."
        />

        <ul class="divide-y divide-(--border) border-y border-(--border)">
            {posts.map((post) => (
                <li>
                    <a href={`/writings/${post.data.slug}`} class="group flex flex-col gap-3 py-6 sm:flex-row sm:items-start sm:gap-8">
                        <span class="shrink-0 pt-1 font-mono text-xs text-(--ink-faint)">Published {formatDate(post.data.published)}</span>
                        <span class="flex min-w-0 flex-col gap-2">
                            <h2 class="text-xl font-semibold text-(--ink) transition group-hover:text-(--accent)">{post.data.title}</h2>
                            <p class="text-sm leading-6 text-(--ink-muted)">{post.data.summary}</p>
                            <ul class="flex flex-wrap gap-2">
                                {post.data.tags.map((tag) => (
                                    <li><TechTag label={tag} /></li>
                                ))}
                            </ul>
                        </span>
                        <span class="shrink-0 self-start pt-1 font-mono text-xs font-semibold uppercase tracking-wide text-(--accent) sm:ml-auto">Read note</span>
                    </a>
                </li>
            ))}
        </ul>
    </div>
</Layout>