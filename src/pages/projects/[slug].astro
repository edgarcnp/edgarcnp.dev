---
import Layout from "~/layouts/Layout.astro"
import { render } from "astro:content"
import { getProjects } from "~/lib/content"
import ArticleView from "~/components/content/ArticleView.astro"

export async function getStaticPaths() {
    const projects = await getProjects()
    return projects.map((project) => ({ params: { slug: project.id }, props: { project } }))
}

const { project } = Astro.props
const { Content } = await render(project)
---

<Layout title={project.data.title} description={project.data.summary} path={`/projects/${project.id}`}>
    <ArticleView
        title={project.data.title}
        published={project.data.published}
        updated={project.data.updated}
        summary={project.data.summary}
        tags={project.data.technologies}
        status={project.data.status}
        links={project.data.links}
        backHref="/projects"
        backLabel="Back to projects"
    >
        <Content />
    </ArticleView>
</Layout>
