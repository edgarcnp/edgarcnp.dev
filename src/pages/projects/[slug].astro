---
import Layout from "~/layouts/Layout.astro"
import { getCollection, render } from "astro:content"
import ArticleHeader from "~/components/shared/ArticleHeader.astro"

export async function getStaticPaths() {
    const projects = await getCollection("projects")
    return projects.map((project) => ({ params: { slug: project.data.slug }, props: { project } }))
}

const { project } = Astro.props
const { Content } = await render(project)
---

<Layout title={project.data.title} description={project.data.summary} path={`/projects/${project.data.slug}`}>
    <article class="mx-auto max-w-3xl space-y-8">
        <ArticleHeader
            title={project.data.title}
            published={project.data.published}
            updated={project.data.updated}
            summary={project.data.summary}
            tags={project.data.technologies}
            status={project.data.status}
            links={project.data.links}
            backHref="/projects"
            backLabel="Back to projects"
        />
        <div class="markdown-body">
            <Content />
        </div>
    </article>
</Layout>