---
import Layout from "~/layouts/Layout.astro"
import { getCollection, getEntry } from "astro:content"
import Grid4 from "~/components/shared/Grid4.astro"
import LinkAction from "~/components/shared/LinkAction.astro"
import ProjectCard from "~/components/shared/ProjectCard.astro"
import SectionHeading from "~/components/shared/SectionHeading.astro"

const projects = (await getCollection("projects")).sort((a, b) => b.data.year - a.data.year)
const featuredProjects = projects.filter((p) => p.data.featured)

const profileEntry = await getEntry("data", "profile")
const contactEntry = await getEntry("data", "contact")
const capabilitiesEntry = await getEntry("data", "capabilities")
if (!profileEntry || !contactEntry || !capabilitiesEntry) {
    throw new Error("Missing site data entry")
}
const profile = profileEntry.data
const contact = contactEntry.data
const capabilities = capabilitiesEntry.data
if (!("name" in profile) || !("links" in contact) || !("capabilities" in capabilities)) {
    throw new Error("Site data entry has unexpected shape")
}
const codeberg = contact.links.find((l) => l.kind === "code")

const stats = [
    { label: "Runtime", value: "Cloudflare Workers" },
    { label: "Interface", value: profile.role },
    { label: "Availability", value: profile.availability },
]
---

<Layout title="edgarcnp.dev" path="/">
    <section>
        <div>
            <p class="kicker">{profile.availability}</p>
            <h1 class="display mt-4">{profile.name}</h1>
            <p class="mt-5 max-w-[65ch] text-lg leading-8 text-(--ink-muted)">{profile.summary}</p>
        </div>
        <div class="mt-8">
            <dl class="card grid gap-4 sm:grid-cols-3 sm:gap-0" data-motion="parallax" data-speed="0.08">
                {stats.map(({ label, value }, index) => (
                    <div class={index > 0 ? "sm:border-l sm:border-(--border) sm:pl-6" : undefined}>
                        <dt class="kicker">{label}</dt>
                        <dd class="mt-1 text-sm text-(--ink)">{value}</dd>
                    </div>
                ))}
            </dl>
        </div>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <LinkAction href="/projects" variant="primary" data-motion="magnetic">View projects</LinkAction>
            <LinkAction href="/contact" variant="secondary">Contact</LinkAction>
        </div>
    </section>

    <section class="section">
        <div>
            <SectionHeading
                label="Selected Work"
                title="Secure content, responsive UI, and edge deployment."
                description="A short list of projects focused on making this portfolio fast, auditable, and stable across devices."
            />
        </div>
        <div class="mt-8 grid gap-4 md:grid-cols-2">
            {featuredProjects.map((p) => (
                <ProjectCard
                    title={p.data.title}
                    href={`/projects/${p.data.slug}`}
                    summary={p.data.summary}
                    year={p.data.year}
                    status={p.data.status}
                    technologies={p.data.technologies}
                    pinned={p.data.pinned}
                />
            ))}
        </div>
    </section>

    <Grid4 items={capabilities.capabilities} />

    <section class="section">
        <div class="grid gap-4 md:grid-cols-2">
            <div class="card flex flex-col justify-between gap-6">
                <div>
                    <p class="kicker">Writing</p>
                    <h2 class="section-title mt-2">Notes from the build.</h2>
                    <p class="section-heading__description mt-3">Short technical writing about security, responsive UI, and Cloudflare deployment.</p>
                </div>
                <div>
                    <LinkAction href="/writings" variant="ghost">Open writing</LinkAction>
                </div>
            </div>
            <div class="card flex flex-col justify-between gap-6">
                <div>
                    <p class="kicker">Contact Endpoint</p>
                    <h2 class="section-title mt-2">Static links, no message collection.</h2>
                    <p class="section-heading__description mt-3">{profile.summary}</p>
                </div>
                <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                    <LinkAction href="/contact" variant="secondary">Open contact</LinkAction>
                    <LinkAction href={`mailto:${profile.email}`} variant="primary">{profile.email}</LinkAction>
                    {codeberg && (
                        <LinkAction href={codeberg.href} external={codeberg.external} variant="secondary">{codeberg.label}</LinkAction>
                    )}
                </div>
            </div>
        </div>
    </section>
</Layout>