---
import Layout from "~/layouts/Layout.astro"
import { getFeaturedProjects } from "~/lib/content"
import { getCapabilities, getContact, getContributions, getProfile } from "~/lib/data"
import CapabilityGrid from "~/components/content/CapabilityGrid.astro"
import ContributionHeatmap from "~/components/content/ContributionHeatmap.astro"
import ProjectCard from "~/components/content/ProjectCard.astro"
import ButtonLink from "~/components/ui/ButtonLink.astro"
import SectionHeading from "~/components/ui/SectionHeading.astro"

const featuredProjects = await getFeaturedProjects()
const profile = await getProfile()
const contact = await getContact()
const capabilities = await getCapabilities()
const contributions = await getContributions()
const codeberg = contact.links.find((l) => l.kind === "code")
---

<Layout title="edgarcnp.dev" path="/">
    <section>
        <div>
            <p class="kicker">{profile.availability}</p>
            <h1 class="display mt-4">{profile.name}</h1>
            <p class="mt-5 max-w-[65ch] text-lg leading-8 text-(--ink-muted)">{profile.summary}</p>
        </div>
        <div class="mt-8">
            <ContributionHeatmap days={contributions.days} />
        </div>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <ButtonLink href="/projects" variant="primary" magnetic>View projects</ButtonLink>
            <ButtonLink href="/contact" variant="secondary">Contact</ButtonLink>
        </div>
    </section>

    <section class="section">
        <div>
            <SectionHeading
                label="Selected Work"
                title="Secure content, responsive UI, and edge deployment."
                description="A short list of projects focused on making this portfolio fast, auditable, and stable across devices."
            />
        </div>
        <div class="mt-8 grid gap-4 extended:grid-cols-2">
            {featuredProjects.map((p) => (
                <ProjectCard
                    title={p.data.title}
                    href={`/projects/${p.id}`}
                    summary={p.data.summary}
                    year={p.data.year}
                    status={p.data.status}
                    technologies={p.data.technologies}
                    pinned={p.data.pinned}
                />
            ))}
        </div>
    </section>

    <CapabilityGrid items={capabilities.capabilities} />

    <section class="section">
        <div class="grid gap-4 extended:grid-cols-2">
            <div class="card flex flex-col justify-between gap-6">
                <div>
                    <p class="kicker">Writing</p>
                    <h2 class="section-title mt-2">Notes from the build.</h2>
                    <p class="section-heading__description mt-3">Short technical writing about security, responsive UI, and Cloudflare deployment.</p>
                </div>
                <div>
                    <ButtonLink href="/writing" variant="ghost">Open writing</ButtonLink>
                </div>
            </div>
            <div class="card flex flex-col justify-between gap-6">
                <div>
                    <p class="kicker">Contact Endpoint</p>
                    <h2 class="section-title mt-2">Static links, no message collection.</h2>
                    <p class="section-heading__description mt-3">{profile.summary}</p>
                </div>
                <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                    <ButtonLink href="/contact" variant="secondary">Open contact</ButtonLink>
                    <ButtonLink href={`mailto:${profile.email}`} variant="primary">{profile.email}</ButtonLink>
                    {codeberg && (
                        <ButtonLink href={codeberg.href} external={codeberg.external} variant="secondary">{codeberg.label}</ButtonLink>
                    )}
                </div>
            </div>
        </div>
    </section>
</Layout>