---
import StatusBadge from "./StatusBadge.astro"
import TechTag from "./TechTag.astro"
import IconArrowRight from "~/components/ui/icons/IconArrowRight.astro"

import type { ProjectStatus } from "~/lib/types"

interface Props {
    title: string
    href: string
    summary: string
    year: number
    status: ProjectStatus
    technologies: string[]
    pinned?: boolean
}

const { title, href, summary, year, status, technologies, pinned } = Astro.props as Props
---
<a href={href} class="card group flex h-full flex-col">
    <div class="flex items-start justify-between gap-4">
        <div>
            {pinned && (
                <span class="pill pill--accent">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 17v5" /><path d="M5 17h14" /><path d="M7 17l2-9h6l2 9" /><path d="M9 8V3h6v5" />
                    </svg>
                    Pinned
                </span>
            )}
            <h3 class="text-lg font-semibold text-(--ink)">{title}</h3>
        </div>
        <span class="shrink-0 font-mono text-xs text-(--ink-faint)">{year}</span>
    </div>
    <p class="mt-4 grow text-sm leading-6 text-(--ink-muted)">{summary}</p>
    <ul class="mt-6 flex flex-wrap gap-2">
        {technologies.map((tech) => (
            <li><TechTag label={tech} /></li>
        ))}
    </ul>
    <div class="mt-6 flex items-center justify-between gap-4">
        <StatusBadge status={status} />
        <span class="inline-flex items-center gap-1.5 font-mono text-[0.7rem] font-medium uppercase tracking-wider text-(--ink-faint) transition group-hover:text-(--accent)">
            Inspect
            <IconArrowRight class="size-3.5" />
        </span>
    </div>
</a>
