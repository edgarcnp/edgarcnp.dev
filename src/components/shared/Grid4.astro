---
interface Item {
    label: string
    title: string
    description: string
}

interface Props {
    items: Item[]
}

const { items } = Astro.props as Props
---
<section class="section">
    <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(min(100%,14rem),1fr))]">
        {items.map(({ label, title, description }) => (
            <article class="card">
                <p class="kicker">{label}</p>
                <h3 class="mt-2 text-lg font-semibold text-(--ink)">{title}</h3>
                <p class="mt-2 text-sm leading-6 text-(--ink-muted)">{description}</p>
            </article>
        ))}
    </div>
</section>