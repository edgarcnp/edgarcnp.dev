---
import { formatDate } from "~/lib/content"
import LinkAction from "./LinkAction.astro"
import StatusBadge from "./StatusBadge.astro"
import TechTag from "./TechTag.astro"
import IconArrowLeft from "~/components/ui/icons/IconArrowLeft.astro"

import type { ProjectStatus } from "~/lib/types"

interface Props {
    title: string
    published: Date
    updated: Date
    summary: string
    tags?: string[]
    status?: ProjectStatus
    links?: { label: string; href: string; external: boolean }[]
    backHref: string
    backLabel: string
}

const { title, published, updated, summary, tags, status, links, backHref, backLabel } = Astro.props as Props
---
<header class="article-header">
    <LinkAction href={backHref} variant="ghost">
        <IconArrowLeft class="size-3.5" />
        {backLabel}
    </LinkAction>
    <p class="kicker">
        <span>Published {formatDate(published)}</span>
        <span aria-hidden="true"> · </span>
        <span>Updated {formatDate(updated)}</span>
    </p>
    {
        status ? (
            <div class="flex flex-wrap items-start justify-between gap-4">
                <h1>{title}</h1>
                <StatusBadge status={status} />
            </div>
        ) : (
            <h1>{title}</h1>
        )
    }
    <p>{summary}</p>
    {
        tags && (
            <ul class="flex flex-wrap gap-2">
                {tags.map((tag) => (
                    <li><TechTag label={tag} /></li>
                ))}
            </ul>
        )
    }
    {
        links && links.length > 0 && (
            <div class="flex flex-wrap gap-3">
                {links.map((link) => (
                    <LinkAction href={link.href} external={link.external} variant="secondary">{link.label}</LinkAction>
                ))}
            </div>
        )
    }
</header>
