---
import { Moon, Sun } from "@lucide/astro"

const { class: _className, ...rest } = Astro.props as Record<string, string | undefined>
---
<button {...rest} type="button" class="theme-toggle" aria-pressed="false" aria-label="Switch to dark theme" title="Switch to dark theme">
    <Moon class="theme-toggle__icon theme-toggle__moon" />
    <Sun class="theme-toggle__icon theme-toggle__sun" />
</button>
<script>import "~/scripts/theme-toggle";</script>