---
import { ACTION_CLASSES } from "~/lib/types"
import IconExternalLink from "~/components/ui/icons/IconExternalLink.astro"

import type { ActionVariant } from "~/lib/types"

interface Props {
    href: string
    external?: boolean
    variant?: ActionVariant
}

const { href, external, variant, class: _className, ...rest } = Astro.props as Props & Record<string, string | undefined>

const isExternal = external ?? (href.startsWith("http") || href.startsWith("mailto:"))
---
<a
    {...rest}
    href={href}
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener noreferrer" : undefined}
    class={ACTION_CLASSES[variant ?? "secondary"]}
>
    <slot />
    {isExternal && <IconExternalLink class="size-3.5 shrink-0" />}
</a>
