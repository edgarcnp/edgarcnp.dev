---
import { ACTION_CLASSES } from "~/lib/types"
import { ExternalLink } from "@lucide/astro"

import type { ActionVariant } from "~/lib/types"

interface Props {
    href: string
    external?: boolean
    variant?: ActionVariant
    magnetic?: boolean
}

const { href, external, magnetic, variant, class: _className, ...rest } = Astro.props as Props & Record<string, string | undefined>

const isExternal = external ?? (href.startsWith("http") || href.startsWith("mailto:"))
---
<a
    {...rest}
    href={href}
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener noreferrer" : undefined}
    class={ACTION_CLASSES[variant ?? "secondary"]}
    data-motion={magnetic ? "magnetic" : undefined}
>
    <slot />
    {isExternal && <ExternalLink class="size-3.5 shrink-0" />}
</a>
