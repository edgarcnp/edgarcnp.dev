---
interface Props {
    label: string
    title: string
    description?: string
}

const { label, title, description } = Astro.props as Props
---
<div class="section-heading">
    <p class="kicker kicker--accent">{label}</p>
    <h2 class="section-title">{title}</h2>
    {description && <p class="section-heading__description">{description}</p>}
</div>
