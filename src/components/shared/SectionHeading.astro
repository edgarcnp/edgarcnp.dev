---
/**
 * Props for the SectionHeading component.
 */
interface Props {
    /** Small uppercase label displayed above the title (e.g. "Projects", "About Me"). */
    label: string
    /** Main heading text (rendered as h2). */
    title: string
    /** Optional descriptive paragraph displayed below the title. */
    description?: string
}

const { label, title, description } = Astro.props as Props
---
<div class="space-y-3">
    <p class="blueprint-label">{label}</p>
    <h2 class="text-2xl font-semibold text-(--blueprint-text)">{title}</h2>
    {description && (
        <p class="text-sm leading-6 text-(--blueprint-muted)">{description}</p>
    )}
</div>