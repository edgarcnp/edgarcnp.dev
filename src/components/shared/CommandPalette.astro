---
import { Search } from "@lucide/astro"
import { getProjects, getWritingPosts } from "~/lib/content"
import { navIndex } from "~/config/site"

const { class: _className, ...rest } = Astro.props as Record<string, string | undefined>

type Command = { id: string; label: string; href: string; category: string; keywords: string[] }

const projects = await getProjects()
const writings = await getWritingPosts()

const commands: Command[] = [
    ...navIndex.map((link) => ({
        id: `nav:${link.label.toLowerCase()}`,
        label: link.label,
        href: link.href,
        category: "Nav",
        keywords: [],
    })),
    ...projects.map((entry) => ({
        id: `project:${entry.id}`,
        label: entry.data.title,
        href: `/projects/${entry.id}`,
        category: "Projects",
        keywords: [...entry.data.technologies, entry.data.summary],
    })),
    ...writings.map((entry) => ({
        id: `writing:${entry.id}`,
        label: entry.data.title,
        href: `/writing/${entry.id}`,
        category: "Writing",
        keywords: [...entry.data.tags, entry.data.summary],
    })),
]
---

<div {...rest} class="palette-field">
    <Search class="palette-trigger__icon" />
    <input
        type="search"
        class="palette-input"
        placeholder="Search commands, projects, writings…"
        role="combobox"
        aria-expanded="false"
        aria-controls="palette-listbox"
        aria-autocomplete="list"
        aria-label="Search"
        autocomplete="off"
        spellcheck="false"
    />
    <kbd class="palette-kbd" aria-hidden="true">⌘ K</kbd>
</div>
<script type="application/json" data-command-index is:inline set:html={JSON.stringify(commands).replace(/</g, "\\u003c")}></script>
<script>import "~/scripts/command-palette";</script>
