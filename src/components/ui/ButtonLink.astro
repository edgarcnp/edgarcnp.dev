---
import type { HTMLAttributes } from "astro/types"
import { ExternalLink } from "@lucide/astro"

type ActionVariant = "primary" | "secondary" | "ghost"

const ACTION_CLASSES: Record<ActionVariant, string> = {
    primary: "btn-primary",
    secondary: "btn-secondary",
    ghost: "btn-ghost",
}

interface Props extends HTMLAttributes<"a"> {
    href: string
    external?: boolean
    variant?: ActionVariant
    magnetic?: boolean
}

const { href, external, magnetic, variant, class: className, ...rest } = Astro.props

const isExternal = external ?? (href.startsWith("http") || href.startsWith("mailto:"))
---
<a
    {...rest}
    href={href}
    target={isExternal ? "_blank" : undefined}
    rel={isExternal ? "noopener noreferrer" : undefined}
    class:list={[ACTION_CLASSES[variant ?? "secondary"], className]}
    data-motion={magnetic ? "magnetic" : undefined}
>
    <slot />
    {isExternal && <ExternalLink class="size-3.5 shrink-0" />}
</a>
