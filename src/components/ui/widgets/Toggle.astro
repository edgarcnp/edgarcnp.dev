---
interface Props {
    class?: string
    checked?: boolean
    disabled?: boolean
    type?: "button" | "submit" | "reset"
    name?: string
    desc?: string
    /** Content rendered in the text block; overrides name/desc when provided. */
    children: unknown
}

const {
    class: className,
    checked = false,
    disabled,
    type = "button",
    name,
    desc,
} = Astro.props as Props
---
<button
    class={["toggle-button card", className].filter(Boolean).join(" ")}
    disabled={disabled}
    type={type}
    role="switch"
    aria-checked={checked}
>
    <div class="toggle-text">
        {Astro.slots.has("default") ? (
            <slot />
        ) : (
            <>
                {name && <h4>{name}</h4>}
                {desc && <p>{desc}</p>}
            </>
        )}
    </div>
    <div class:list={["toggle", { enabled: checked }]} aria-hidden="true">
        <div class="runner" />
    </div>
</button>