---
interface Props {
    id?: string
    /** Named slot: the element the tooltip is anchored to. */
    anchor: unknown
    /** Named slot: the tooltip content. */
    content: unknown
}

const { id } = Astro.props as Props
---
<div class="tooltip-anchor" role="group" aria-describedby={id}>
    <slot name="anchor" />
</div>
<div popover="manual" class="tooltip-container" role="tooltip" id={id}>
    <div class="tooltip-content">
        <slot name="content" />
    </div>
</div>