---
import Input from "./Input.astro"

interface Props {
    id: string
    "aria-label": string
    class?: string
    value?: string
    placeholder?: string
    small?: boolean
    width?: string
}

const {
    id,
    "aria-label": ariaLabel,
    class: className,
    value,
    placeholder,
    small,
    width,
} = Astro.props as Props
---
<div
    class="search-bar"
    role="search"
    style={width ? { "--input-width": width } : undefined}
>
    <Input
        id={id}
        small={small}
        width="100%"
        type="search"
        value={value}
        placeholder={placeholder}
        aria-label={ariaLabel}
        class={className}
    >
        <svg
            slot="leading"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <path d="M3 10a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
            <path d="M21 21l-6 -6" />
        </svg>
    </Input>
</div>