---
interface Props {
    href: string
    class?: string
    target?: string
    rel?: string
    children: unknown
}

const { href, class: className, target, rel } = Astro.props as Props

const isExternal = (() => {
    try {
        return new URL(href, Astro.url).origin !== Astro.url.origin
    } catch {
        return true
    }
})()

const resolvedTarget = isExternal ? (target ?? "_blank") : target
const resolvedRel = isExternal ? (rel ?? "noopener noreferrer") : rel
---
<a
    class={["p-link", className].filter(Boolean).join(" ")}
    href={href}
    target={resolvedTarget}
    rel={resolvedRel}
>
    <slot />
</a>