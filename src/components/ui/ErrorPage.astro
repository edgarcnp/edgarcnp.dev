---
import ButtonLink from "~/components/ui/ButtonLink.astro"

interface Props {
    code: string
    title: string
    path: string
}

const { code, title, path } = Astro.props

const MAX_PATH_LENGTH = 120
const displayPath = path.length > MAX_PATH_LENGTH ? path.slice(0, MAX_PATH_LENGTH) + "…" : path
---
<section class="error-page" data-motion="reveal error-code">
    <p class="error-page__code" data-reveal>{code}</p>
    <h1 data-reveal>{title}</h1>
    <p data-reveal>No page at <code>{displayPath}</code> — try searching (⌘K) or return home.</p>
    <div class="flex flex-col gap-3 sm:flex-row" data-reveal>
        <ButtonLink href="/" variant="primary" magnetic>Return home</ButtonLink>
        <ButtonLink href="/projects" variant="secondary" magnetic>View projects</ButtonLink>
    </div>
</section>
<style>
  .error-page {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 42rem;
  }

  .error-page__code {
    font-family: var(--font-mono);
    font-size: clamp(4rem, 12vw, 6.5rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink-faint);
  }

  .error-page h1 {
    font-family: var(--font-sans);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    color: var(--ink);
  }

  .error-page p {
    max-width: 65ch;
    line-height: 1.7;
    color: var(--ink-muted);
  }

  .error-page code {
    padding: 0.15em 0.35em;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
</style>
