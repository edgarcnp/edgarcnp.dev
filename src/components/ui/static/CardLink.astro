---
import IconExternalLink from "../icons/IconExternalLink.astro"

/**
 * Props for the CardLink component.
 */
interface CardLinkProps {
    /** Card heading text. */
    title: string
    /** Description paragraph below the title. */
    desc: string
    /** External URL to link to. */
    href: string
    /** Additional CSS classes to merge with the default card styling. */
    class?: string
}

const { title, desc, href, class: className } = Astro.props as CardLinkProps
---
<a
    class={`button card card-link ${className ?? ""}`}
    href={href}
    target="_blank"
    rel="noopener noreferrer"
>
    <div class="link-text">
        <h4>{title}</h4>
        <p>{desc}</p>
    </div>
    <IconExternalLink />
</a>