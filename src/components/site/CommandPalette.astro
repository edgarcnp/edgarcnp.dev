---
import type { HTMLAttributes } from "astro/types"
import { Search } from "@lucide/astro"
import { buildCommandIndex } from "~/lib/commands"

type Props = HTMLAttributes<"div">

const { class: className, ...rest } = Astro.props

const commands = await buildCommandIndex()
---

<div {...rest} class:list={["palette-field", className]}>
    <Search class="palette-trigger__icon" />
    <input
        type="search"
        class="palette-input"
        placeholder="Search commands, projects, writings…"
        role="combobox"
        aria-expanded="false"
        aria-controls="palette-listbox"
        aria-autocomplete="list"
        aria-label="Search"
        autocomplete="off"
        spellcheck="false"
    />
    <kbd class="palette-kbd" aria-hidden="true">⌘ K</kbd>
</div>
<script type="application/json" data-command-index is:inline set:html={JSON.stringify(commands).replace(/</g, "\\u003c")}></script>
<script>import "~/scripts/command-palette";</script>
