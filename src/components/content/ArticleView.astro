---
import ArticleHeader from "~/components/content/ArticleHeader.astro"

import type { ProjectStatus } from "~/lib/content"

interface Props {
    title: string
    published: Date
    updated: Date
    summary: string
    tags?: string[]
    status?: ProjectStatus
    links?: { label: string; href: string; external: boolean }[]
    backHref: string
    backLabel: string
}

const { title, published, updated, summary, tags, status, links, backHref, backLabel } = Astro.props
---
<article class="mx-auto max-w-3xl">
    <div>
        <ArticleHeader
            title={title}
            published={published}
            updated={updated}
            summary={summary}
            tags={tags}
            status={status}
            links={links}
            backHref={backHref}
            backLabel={backLabel}
        />
    </div>
    <div class="markdown-body">
        <slot />
    </div>
</article>
<!-- The body is rendered Markdown, not template-authored DOM: it carries no scoped
     CID attribute, so these rules must stay global (all selectors are namespaced
     under .markdown-body). -->
<style is:global>
  .markdown-body {
    max-width: 65ch;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--ink);
  }

  .markdown-body > * + * {
    margin-top: 1.25rem;
  }

  .markdown-body h2 {
    margin-top: 2.5rem;
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--ink);
  }

  .markdown-body h3 {
    margin-top: 2rem;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--ink);
  }

  .markdown-body p {
    color: var(--ink);
  }

  .markdown-body a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .markdown-body a:hover {
    text-decoration-thickness: 1.5px;
  }

  .markdown-body ul,
  .markdown-body ol {
    padding-left: 1.25rem;
  }

  .markdown-body li + li {
    margin-top: 0.5rem;
  }

  .markdown-body code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--ink);
  }

  .markdown-body :not(pre) > code {
    padding: 0.15em 0.35em;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
  }

  .markdown-body pre {
    padding: 1rem;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
  }

  .markdown-body pre code {
    padding: 0;
    border: none;
    background: none;
  }

  .markdown-body blockquote {
    padding-inline-start: 1rem;
    border-inline-start: 1px solid var(--border);
    color: var(--ink-muted);
  }

  .markdown-body hr {
    margin-block: 2.5rem;
    border: none;
    border-top: 1px solid var(--border);
  }

  .markdown-body strong {
    font-weight: 600;
  }

  .markdown-body img {
    max-width: 100%;
    border-radius: var(--radius);
  }
</style>
