---
import { formatDate } from "~/lib/format"
import ButtonLink from "~/components/ui/ButtonLink.astro"
import StatusBadge from "~/components/ui/StatusBadge.astro"
import Tag from "~/components/ui/Tag.astro"
import { ArrowLeft } from "@lucide/astro"

import type { ProjectStatus } from "~/lib/content"

interface Props {
    title: string
    published: Date
    updated: Date
    summary: string
    tags?: string[]
    status?: ProjectStatus
    links?: { label: string; href: string; external: boolean }[]
    backHref: string
    backLabel: string
}

const { title, published, updated, summary, tags, status, links, backHref, backLabel } = Astro.props
---
<header class="article-header">
    <ButtonLink href={backHref} variant="ghost">
        <ArrowLeft class="size-3.5" />
        {backLabel}
    </ButtonLink>
    <p class="kicker">
        <span>Published {formatDate(published)}</span>
        <span aria-hidden="true"> · </span>
        <span>Updated {formatDate(updated)}</span>
    </p>
    {
        status ? (
            <div class="flex flex-wrap items-start justify-between gap-4">
                <h1>{title}</h1>
                <StatusBadge status={status} />
            </div>
        ) : (
            <h1>{title}</h1>
        )
    }
    <p>{summary}</p>
    {
        tags && (
            <ul class="flex flex-wrap gap-2">
                {tags.map((tag) => (
                    <li><Tag label={tag} /></li>
                ))}
            </ul>
        )
    }
    {
        links && links.length > 0 && (
            <div class="flex flex-wrap gap-3">
                {links.map((link) => (
                    <ButtonLink href={link.href} external={link.external} variant="secondary">{link.label}</ButtonLink>
                ))}
            </div>
        )
    }
</header>
<style>
  .article-header {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .article-header h1 {
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 3vw + 0.5rem, 2.75rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .article-header p:not(.kicker) {
    max-width: 65ch;
    line-height: 1.7;
    color: var(--ink-muted);
  }

  .article-header ul {
    margin: 0;
    padding-inline-start: 0;
    list-style: none;
  }

  .article-header code {
    padding: 0.15em 0.35em;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
</style>
