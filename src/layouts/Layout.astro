---
import { ClientRouter } from "astro:transitions"
import profileData from "~/data/profile.json"
import { headerNav } from "~/data/nav"
import "../styles/app.css"
import CommandPalette from "~/components/shared/CommandPalette.astro"
import SkipLink from "~/components/shared/SkipLink.astro"
import ThemeToggle from "~/components/shared/ThemeToggle.astro"

interface Props {
    title: string
    description?: string
    path: string
}

const { title, description, path } = Astro.props
const email: string = profileData.email
const tickerItems = ["Rust", "Dioxus", "Cloudflare"]
const tickerRow = Array.from({ length: 12 }, () => tickerItems).flat()
const DEFAULT_DESCRIPTION = "Software engineer building secure, pragmatic web systems."
const metaDescription = description ?? DEFAULT_DESCRIPTION
const siteName = "edgarcnp.dev"
const fullTitle = !title ? siteName : title === siteName ? title : `${title} — ${siteName}`
const hostname = Astro.site?.host ?? "edgarcnp.dev"

const navLinks = headerNav.map((link) => ({ href: link.href, label: link.label, active: link.match(path) }))
---

<!doctype html>
<html lang="en">
    <head>
        <script src="/js/theme-init.js" is:inline></script>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>{fullTitle}</title>
        <meta name="description" content={metaDescription} />
        <link rel="canonical" href={`https://edgarcnp.dev${path}`} />
        <ClientRouter />
    </head>
    <body>
        <SkipLink />
        <div class="ambient-bg" aria-hidden="true" transition:persist="ambient"></div>

        <header class="site-header border-b border-(--border)">
            <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 px-[max(clamp(1.25rem,4vw,2.5rem),env(safe-area-inset-left),env(safe-area-inset-right))] py-2.5 md:grid md:grid-cols-[1fr_auto_1fr] md:flex-nowrap">
                <a href="/" class="group flex w-fit min-h-11 items-center gap-3 pr-2 [view-transition-name:brand]">
                    <span class="grid size-9 place-items-center rounded-sm border border-(--border) font-mono text-xs font-semibold text-(--ink-muted) transition group-hover:border-(--accent) group-hover:text-(--accent)">
                        EC
                    </span>
                    <span class="flex flex-col leading-none">
                        <span class="text-sm font-semibold text-(--ink) transition group-hover:text-(--accent)">{hostname}</span>
                        <span class="mt-1 text-[0.65rem] uppercase tracking-[0.18em] text-(--ink-faint)">Portfolio</span>
                    </span>
                </a>
                <CommandPalette transition:persist />
                <nav aria-label="Primary navigation" class="nav md:justify-self-end">
                    {navLinks.map((link) => (
                        <a href={link.href} class="nav-link" aria-current={link.active ? "page" : undefined}>{link.label}</a>
                    ))}
                    <ThemeToggle transition:persist />
                </nav>
            </div>
        </header>

        <main id="main">
            <div class="page">
                <slot />
            </div>
        </main>

        <footer class="footer">
            <div class="footer__band flex flex-col items-stretch gap-3 text-center sm:flex-row sm:items-center sm:gap-x-6">
                <p class="footer__meta min-w-0 sm:flex-none sm:text-left">&copy; 2026 Edgar Christian</p>
                <div class="footer__ticker min-w-0 overflow-hidden sm:flex-1" aria-hidden="true">
                    <div class="footer__ticker-track" data-motion="marquee" data-duration="30">
                        <div class="footer__ticker-group">
                            {tickerRow.map((item) => (
                                <span class="pill mr-4">{item}</span>
                            ))}
                        </div>
                        <div class="footer__ticker-group">
                            {tickerRow.map((item) => (
                                <span class="pill mr-4">{item}</span>
                            ))}
                        </div>
                    </div>
                </div>
                <a class="footer__meta min-w-0 sm:flex-none sm:text-right" href={`mailto:${email}`}>{email}</a>
            </div>
        </footer>

        <script>import "~/scripts/motion-client";</script>
        <script>import "~/scripts/background-motion";</script>
        <script>import "~/scripts/curtains";</script>
    </body>
</html>
