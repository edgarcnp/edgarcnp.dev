---
import "../styles/app.css"
import "../styles/external-warn.css"
import BaseHead from "~/components/site/BaseHead.astro"
import SiteFooter from "~/components/site/SiteFooter.astro"
import SiteHeader from "~/components/site/SiteHeader.astro"
import SkipLink from "~/components/site/SkipLink.astro"

interface Props {
    title: string
    description?: string
    path: string
}

const { title, description, path } = Astro.props
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={title} description={description} path={path} />
    </head>
    <body>
        <SkipLink />
        <div class="ambient-bg" aria-hidden="true" transition:persist="ambient"></div>

        <SiteHeader path={path} />

        <div id="content-warp">
            <main id="main">
                <div class="page">
                    <slot />
                </div>
            </main>
        </div>

        <SiteFooter />

        <script>import "~/scripts/motion-client";</script>
        <script>import "~/scripts/background-motion";</script>
        <script>import "~/scripts/curtains";</script>
        <script>import "~/scripts/external-warn";</script>
        <script>import "~/scripts/nav-active";</script>
        <script>import "~/scripts/mobile-menu";</script>
    </body>
</html>
